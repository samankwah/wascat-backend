            "title": "Type"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Where the file is served from."
          },
          "objectKey": {
            "type": "string",
            "title": "Objectkey",
            "description": "Key within the object store."
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "checksum": {
            "type": "string",
            "title": "Checksum",
            "description": "SHA-256 of the delivered file."
          },
          "mediaType": {
            "type": "string",
            "title": "Mediatype"
          }
        },
        "type": "object",
        "required": [
          "type",
          "url",
          "objectKey",
          "bytes",
          "checksum",
          "mediaType"
        ],
        "title": "ArtifactOut"
      },
      "CollectionEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CollectionOut"
