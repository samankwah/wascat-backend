          },
          "segmentation": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Segmentation"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "seasons": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Seasons"
          },
          "timesOfDay": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Timesofday"
          },
          "locations": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "type": "array",
            "title": "Locations"
          }
