            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ImageRecordOut"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta",
          "links"
        ],
        "title": "ImageEnvelope"
      },
      "ImagePage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ImageRecordOut"
            },
            "type": "array",
            "title": "Data"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          },
          "links": {
            "$ref": "#/components/schemas/PageLinks"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta",
