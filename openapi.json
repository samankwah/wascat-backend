      "ImageRecordOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "collection": {
            "type": "string",
            "title": "Collection"
          },
          "release": {
            "type": "string",
            "title": "Release"
          },
          "videoId": {
            "type": "string",
            "title": "Videoid"
          },
          "frameIndex": {
            "type": "integer",
            "title": "Frameindex"
          },
          "cloudFraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cloudfraction"
          },
          "cloudCoverOktas": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cloudcoveroktas"
          },
          "maskScale": {
            "type": "number",
            "title": "Maskscale",
            "description": "Scale at which the mask was delivered relative to its frame. 1 for a correctly registered sequence; greater where the mask was rendered larger and the viewer must scale it back."
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "image": {
            "type": "string",
            "title": "Image",
            "description": "Primary listing image: the frame, else the mask."
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceurl"
          },
          "maskUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maskurl"
          },
          "hasSource": {
            "type": "boolean",
            "title": "Hassource"
          },
          "hasMask": {
            "type": "boolean",
            "title": "Hasmask"
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactOut"
            },
            "type": "array",
            "title": "Artifacts"
          },
