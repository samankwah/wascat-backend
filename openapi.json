        "required": [
          "slug",
          "title",
          "shortTitle",
          "kicker",
          "description",
          "coverage",
          "videoIds",
          "images",
          "artifacts",
          "withSource",
          "segmented",
          "image",
          "imageAlt"
        ],
        "title": "CollectionSummaryOut",
        "description": "The listing shape: the release history replaced by the current one."
      },
      "Coordinates": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinates"
      },
      "CountMeta": {
        "properties": {
          "apiVersion": {
            "type": "string",
            "title": "Apiversion",
            "default": "1.0"
          },
          "generatedAt": {
            "type": "string",
            "title": "Generatedat"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
