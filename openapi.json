      },
      "CollectionOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "shortTitle": {
            "type": "string",
            "title": "Shorttitle"
          },
          "kicker": {
            "type": "string",
            "title": "Kicker"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "coverage": {
            "type": "string",
            "title": "Coverage"
          },
          "videoIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Videoids"
          },
          "images": {
            "type": "integer",
            "title": "Images"
          },
          "artifacts": {
            "type": "integer",
            "title": "Artifacts"
          },
          "withSource": {
            "type": "integer",
            "title": "Withsource"
          },
          "segmented": {
            "type": "integer",
            "title": "Segmented",
            "description": "Records carrying a mask, and so a measurement."
          },
          "image": {
            "type": "string",
            "title": "Image"
          },
          "imageAlt": {
            "type": "string",
            "title": "Imagealt"
          },
          "releases": {
            "items": {
              "$ref": "#/components/schemas/ReleaseOut"
            },
            "type": "array",
            "title": "Releases",
            "default": []
          },
          "locationName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locationname"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          },
          "instrument": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instrument"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "citation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doi"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "title",
          "shortTitle",
          "kicker",
          "description",
          "coverage",
          "videoIds",
          "images",
          "artifacts",
          "withSource",
          "segmented",
          "image",
          "imageAlt"
        ],
        "title": "CollectionOut"
      },
      "CollectionSummaryOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "shortTitle": {
            "type": "string",
            "title": "Shorttitle"
          },
          "kicker": {
            "type": "string",
            "title": "Kicker"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "coverage": {
            "type": "string",
            "title": "Coverage"
          },
          "videoIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Videoids"
          },
          "images": {
            "type": "integer",
            "title": "Images"
          },
          "artifacts": {
            "type": "integer",
            "title": "Artifacts"
          },
          "withSource": {
            "type": "integer",
            "title": "Withsource"
          },
          "segmented": {
            "type": "integer",
            "title": "Segmented",
            "description": "Records carrying a mask, and so a measurement."
          },
          "image": {
            "type": "string",
            "title": "Image"
          },
          "imageAlt": {
            "type": "string",
            "title": "Imagealt"
          },
          "releases": {
            "items": {
              "$ref": "#/components/schemas/ReleaseOut"
            },
            "type": "array",
            "title": "Releases",
            "default": []
          },
          "locationName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locationname"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          },
          "instrument": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instrument"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "citation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doi"
          },
