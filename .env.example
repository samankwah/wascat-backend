# Copy to .env for local development. Every key is prefixed WASCAT_.
# `docker compose up` provisions services matching these defaults, so an
# unedited copy of this file works out of the box.

WASCAT_ENVIRONMENT=local
WASCAT_DEBUG=true

# Database
WASCAT_DATABASE_URL=postgresql+asyncpg://wascat:wascat@localhost:5432/wascat

# Public URLs.
# PUBLIC_BASE_URL is the origin the *browser* uses. The Next.js frontend
# proxies /api/* here, so without it links.self would echo this service's
# internal address instead of the site's.
WASCAT_PUBLIC_BASE_URL=http://localhost:3000
# Prefix for object keys. Empty renders "/frames/vid1/2-source.jpg", exactly
# what the bundled catalogue served. Point it at a CDN in production.
WASCAT_PUBLIC_ASSET_BASE_URL=http://localhost:9000/wascat

# Object storage (MinIO locally, any S3 in production)
WASCAT_S3_ENDPOINT_URL=http://localhost:9000
WASCAT_S3_BUCKET=wascat
WASCAT_S3_REGION=us-east-1
WASCAT_S3_ACCESS_KEY=wascat
WASCAT_S3_SECRET_KEY=wascat-dev-secret

# Security. Generate a real one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# The app refuses to start in staging/production while this is the default.
WASCAT_SECRET_KEY=dev-only-change-me
# Cookies must be Secure over HTTPS; local development is plain HTTP.
WASCAT_COOKIE_SECURE=false
WASCAT_ADMIN_ORIGINS=["http://localhost:3000"]

# Frontend cache invalidation. The admin calls this after a mutation so a
# published edit shows on the public site immediately.
WASCAT_FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
WASCAT_FRONTEND_REVALIDATE_SECRET=dev-only-change-me

# Tests point at the throwaway database from docker-compose.test.yml.
# WASCAT_TEST_DATABASE_URL=postgresql+asyncpg://wascat:wascat@localhost:55433/wascat_test
